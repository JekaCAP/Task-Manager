# Скопируй в .env на VPS (cp .env.example .env), если нужен свой JWT-секрет.
# Без него используется дефолтный секрет из application.yaml (для песочницы ок).
# Если задаёшь здесь — раскомментируй JWT_SECRET в docker-compose.yml (services.app.environment).

# JWT_SECRET=replace-with-your-own-random-secret-min-256-bits-long-for-hs256
