# Copy to .env.prod on the VPS and fill secrets. Do not commit .env.prod.

POSTGRES_DB=taskmanager
POSTGRES_USER=taskmanager
POSTGRES_PASSWORD=change_me_strong_password

# Min 256-bit secret for HS256 JWT
JWT_SECRET=change_me_at_least_32_chars_random_string_for_jwt

# Backend on localhost only — nginx (web) proxies /api for students.
# Use 8084 if 8083 is taken (e.g. study-hub on the same VPS).
APP_HOST_PORT=8084

# Public HTTP origin (IP or domain). Must match how students open the UI (include :port if not 80).
CORS_ALLOWED_ORIGINS=http://51.195.82.237:8080

# Public HTTP port for nginx (frontend + API proxy).
# Use 8080 if port 80 is taken (e.g. study-hub nginx on the same VPS).
WEB_HOST_PORT=8080

# Leave empty to build images locally on VPS
TASKMANAGER_BACKEND_IMAGE=
TASKMANAGER_WEB_IMAGE=
