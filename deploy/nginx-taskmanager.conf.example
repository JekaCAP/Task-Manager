# Host nginx (optional alternative to Docker "web" service).
# Place in /etc/nginx/sites-available/taskmanager and symlink to sites-enabled.
#
# Prerequisites:
#   cd frontend && npm ci && npm run build
#   sudo mkdir -p /var/www/taskmanager
#   sudo rsync -av --delete frontend/dist/ /var/www/taskmanager/
#
# Backend must listen on 127.0.0.1:8083 (APP_HOST_PORT in docker-compose.prod.yml).

upstream taskmanager_backend {
    server 127.0.0.1:8083;
    keepalive 32;
}

server {
    listen 80;
    server_name 51.195.82.237;

    root /var/www/taskmanager;
    index index.html;

    client_max_body_size 10m;

    location /api/ {
        proxy_pass http://taskmanager_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location /swagger-ui/ {
        proxy_pass http://taskmanager_backend;
        proxy_set_header Host $host;
    }

    location = /swagger-ui.html {
        proxy_pass http://taskmanager_backend;
        proxy_set_header Host $host;
    }

    location /v3/api-docs {
        proxy_pass http://taskmanager_backend;
        proxy_set_header Host $host;
    }

    location = /openapi.yaml {
        proxy_pass http://taskmanager_backend;
        proxy_set_header Host $host;
    }

    location /actuator/health {
        proxy_pass http://taskmanager_backend;
        proxy_set_header Host $host;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
