        {
          "name": "03 Create Task",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const runId = pm.variables.replaceIn('{{$guid}}');",
                  "pm.variables.set('runId', runId);",
                  "pm.variables.set('taskTitle', 'Автотест ' + runId);",
                  "pm.variables.set('taskDescription', 'Создано из Postman ' + new Date().toISOString());",
                  "const dueDate = new Date();",
                  "dueDate.setDate(dueDate.getDate() + 3);",
                  "pm.variables.set('taskDueDate', dueDate.toISOString());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "const uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;",
                  "",
                  "pm.test('TaskResponse has all required fields', function () {",
                  "    pm.expect(response).to.include.keys(",
                  "        'id', 'projectId', 'title', 'description', 'status', 'priority',",
                  "        'assigneeId', 'dueDate', 'version', 'createdAt', 'updatedAt'",
                  "    );",
                  "});",
                  "",
                  "pm.test('Title contains generated runId (UUID)', function () {",
                  "    const runId = pm.variables.get('runId');",
                  "    pm.expect(response.title).to.include(runId);",
                  "    pm.expect(runId).to.match(uuidRegex);",
                  "});",
                  "",
                  "pm.test('Default status is TODO, version is 0', function () {",
                  "    pm.expect(response.status).to.eql('TODO');",
                  "    pm.expect(response.version).to.eql(0);",
                  "});",
                  "",
                  "pm.test('Returned data matches sent data', function () {",
                  "    pm.expect(response.title).to.eql(pm.variables.get('taskTitle'));",
                  "    pm.expect(response.projectId).to.eql(pm.environment.get('demoProjectId'));",
                  "    pm.expect(response.priority).to.eql('MEDIUM');",
                  "});",
                  "",
                  "const taskResponseSchema = {",
                  "    type: 'object',",
                  "    required: ['id', 'projectId', 'title', 'status', 'priority', 'version', 'createdAt', 'updatedAt'],",
                  "    properties: {",
                  "        id: { type: 'string', format: 'uuid' },",
                  "        projectId: { type: 'string', format: 'uuid' },",
                  "        title: { type: 'string' },",
                  "        description: { type: 'string' },",
                  "        status: { type: 'string', enum: ['TODO', 'IN_PROGRESS', 'REVIEW', 'DONE', 'CANCELLED'] },",
                  "        priority: { type: 'string', enum: ['LOW', 'MEDIUM', 'HIGH', 'CRITICAL'] },",
                  "        assigneeId: { type: ['string', 'null'], format: 'uuid' },",
                  "        dueDate: { type: ['string', 'null'], format: 'date-time' },",
                  "        version: { type: 'integer' },",
                  "        createdAt: { type: 'string', format: 'date-time' },",
                  "        updatedAt: { type: 'string', format: 'date-time' }",
                  "    }",
                  "};",
                  "",
                  "pm.test('Response matches TaskResponse OpenAPI schema', function () {",
                  "    pm.response.to.have.jsonSchema(taskResponseSchema);",
                  "});",
                  "",
                  "pm.environment.set('taskId', response.id);",
                  "pm.environment.set('taskVersion', String(response.version));",
                  "pm.environment.set('taskTitle', response.title);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectId\": \"{{demoProjectId}}\",\n  \"title\": \"{{taskTitle}}\",\n  \"description\": \"{{taskDescription}}\",\n  \"priority\": \"MEDIUM\",\n  \"dueDate\": \"{{taskDueDate}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/tasks"
          }
        }
      ]
