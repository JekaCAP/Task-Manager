            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectId\": \"{{demoProjectId}}\",\n  \"title\": \"{{hwTaskTitle}}\",\n  \"priority\": \"LOW\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/tasks"
          }
        },
        {
          "name": "Invalid status transition TODO to DONE",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 422', function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "pm.test('Error code is UNPROCESSABLE_ENTITY', function () {",
                  "    pm.expect(pm.response.json().code).to.eql('UNPROCESSABLE_ENTITY');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"DONE\",\n  \"version\": {{hwTaskVersion}}\n}"
            },
            "url": "{{baseUrl}}/api/v1/tasks/{{hwTaskId}}/status"
          }
        },
        {
          "name": "Cleanup — Delete HW task",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Cleanup: status 204', function () { pm.response.to.have.status(204); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/v1/tasks/{{hwTaskId}}"
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "accessToken", "value": "" }
  ]
}
