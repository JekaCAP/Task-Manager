{
  "info": {
    "_postman_id": "d4e5f6a7-b8c9-0123-def4-567890123456",
    "name": "Task Manager — Course Module 3",
    "description": "Коллекция под курс Postman, модуль 3 (уроки 3.1–3.3 + домашка).\n\n**Импорт:** этот файл + `Task-Manager-Sandbox-VPS.postman_environment.json`.\n\n**Запуск:**\n- `03 Pre-request` — урок 3.1 (auto-login на коллекции)\n- `04 CRUD E2E` — урок 3.2\n- `05 Homework Negatives` — негативы из ДЗ\n\n**Runner:** ПКМ на папке → Run folder, **Keep variable values** ON.\n\n**Demo:** qa@demo.com / Demo123! · VPS `http://51.195.82.237:8090`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "const skipAutoLogin = ['Get Me — without token', 'Login — wrong password'];",
          "if (skipAutoLogin.includes(pm.info.requestName)) {",
          "    return;",
          "}",
          "",
          "let token = pm.collectionVariables.get('accessToken') || pm.environment.get('accessToken');",
          "if (!token) {",
          "    const baseUrl = pm.environment.get('baseUrl');",
          "    const loginRes = await pm.sendRequest({",
          "        url: `${baseUrl}/api/v1/auth/login`,",
          "        method: 'POST',",
          "        header: { 'Content-Type': 'application/json' },",
          "        body: {",
          "            mode: 'raw',",
          "            raw: JSON.stringify({",
          "                email: pm.environment.get('userEmail'),",
          "                password: pm.environment.get('userPassword')",
          "            })",
          "        }",
          "    });",
          "    if (loginRes.code !== 200) {",
          "        console.error('Auto-login failed:', loginRes.code, loginRes.text());",
          "    } else {",
          "        const body = loginRes.json();",
          "        pm.collectionVariables.set('accessToken', body.accessToken);",
          "        pm.environment.set('accessToken', body.accessToken);",
          "        pm.environment.set('refreshToken', body.refreshToken);",
          "        pm.environment.set('userId', body.user.id);",
          "        console.log('Auto-login OK, userId =', body.user.id);",
          "    }",
          "}"
        ],
        "type": "text/javascript"
      }
    }
  ],
  "item": [
    {
      "name": "03 Pre-request",
      "description": "Урок 3.1: auto-login на коллекции, UUID в Pre-request, TaskResponse в Post-response + OpenAPI schema.",
      "item": [
        {
          "name": "01 List Projects — DEMO",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Projects list is not empty', function () {",
                  "    pm.expect(body.content).to.be.an('array').that.is.not.empty;",
                  "});",
                  "",
                  "const demo = body.content.find(p => p.key === 'DEMO');",
                  "",
                  "pm.test('Project DEMO exists in sandbox', function () {",
                  "    pm.expect(demo, 'Project with key DEMO not found').to.exist;",
                  "});",
                  "",
                  "if (demo) {",
                  "    pm.environment.set('demoProjectId', demo.id);",
                  "    pm.test('DEMO project is not archived', function () {",
                  "        pm.expect(demo.archived).to.eql(false);",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/projects?size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "projects"],
              "query": [{ "key": "size", "value": "20" }]
            }
          }
        },
