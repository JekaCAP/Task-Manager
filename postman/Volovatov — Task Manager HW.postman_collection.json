                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Get Task by ID: статус 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"task.id == taskId\", function () {\n    const json = pm.response.json();\n    const taskId = pm.environment.get(\"taskId\");\n    pm.expect(String(json.task.id)).to.eql(String(taskId));\n});\n\nconst json = pm.response.json();\nif (json.task && json.task.version !== undefined) {\n    pm.environment.set(\"taskVersion\", json.task.version);\n}"
                ]
              }
            }
          ],
