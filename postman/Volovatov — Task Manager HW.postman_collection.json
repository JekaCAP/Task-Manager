      "name": "Happy path",
      "item": [
        {
          "name": "Get token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// --- Сохранение токена ---\r\nconst jsonData = pm.response.json();\r\npm.environment.set('accessToken', jsonData.accessToken);\r\n\r\n// --- Тесты ---\r\npm.test(\"Статус-код 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\npm.test(\"Ответ содержит accessToken\", function () {\r\n    pm.expect(jsonData).to.have.property('accessToken');\r\n});\r\npm.test(\"accessToken не пустой\", function () {\r\n    pm.expect(jsonData.accessToken).to.not.be.empty;\r\n});\r\npm.test(\"Email пользователя совпадает с qa@demo.com\", function () {\r\n    pm.expect(jsonData.user.email).to.equal('qa@demo.com');\r\n});\r\n"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"email\": \"{{userEmail}}\",\r\n  \"password\": \"{{userPassword}}\"\r\n}\r\n",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Projects",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус код 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Найден проект с key = DEMO\", function () {\r\n    const json = pm.response.json();\r\n    \r\n    const projects = json.content || json.items || json;\r\n    \r\n    const demoProject = projects.find(p => p.key === \"DEMO\");\r\n    \r\n    pm.expect(demoProject, \"Project with key DEMO not found\").to.not.be.undefined;\r\n    \r\n    pm.environment.set(\"demoProjectId\", demoProject.id);\r\n});"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const initials = 'VAA'; // замените на свои инициалы\r\nconst uniqueTitle = `HW-${initials}-${Date.now()}`;\r\npm.environment.set('taskTitle', uniqueTitle);\r\n"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/projects?size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "projects"
              ],
              "query": [
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            }
          },
          "response": []
