        {
          "name": "Update Task Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Update Task Status: статус 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"status = IN_PROGRESS\", function () {\r\n    const json = pm.response.json();\r\n    pm.expect(json.status).to.eql(\"IN_PROGRESS\");\r\n});\r\n\r\npm.test(\"version увеличилась\", function () {\r\n    const json = pm.response.json();\r\n    const prevVersion = pm.environment.get(\"taskVersion\");\r\n    pm.expect(json.version).to.be.above(Number(prevVersion));\r\n    pm.environment.set(\"taskVersion\", json.version);\r\n});"
                ]
              }
            }
          ],
