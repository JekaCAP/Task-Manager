        {
          "name": "Create Task",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус код 201\", function () {\n    pm.response.to.have.status(201);\n});\n\npm.test(\"status = TODO\", function () {\n    const json = pm.response.json();\n    pm.expect(json.status).to.eql(\"TODO\");\n});\n\npm.test(\"version = 0\", function () {\n    const json = pm.response.json();\n    pm.expect(json.version).to.eql(0);\n});\n\npm.test(\"title совпадает\", function () {\n    const json = pm.response.json();\n    pm.expect(json.title).to.eql(pm.environment.get(\"taskTitle\"));\n});\n\npm.test(\"Сохранить taskId и taskVersion\", function () {\n    const json = pm.response.json();\n    pm.expect(json.id).to.be.a(\"string\");\n    pm.environment.set(\"taskId\", json.id);\n    pm.environment.set(\"taskVersion\", json.version);\n});"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const initials = 'VAA'; // замените на свои инициалы\r\nconst uniqueTitle = `HW-${initials}-${Date.now()}`;\r\npm.environment.set('taskTitle', uniqueTitle);\r\n"
                ]
              }
            }
          ],
