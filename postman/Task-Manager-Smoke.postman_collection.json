{
  "info": {
    "_postman_id": "b2c3d4e5-f6a7-8901-bcde-f12345678902",
    "name": "Task Manager — Smoke API",
    "description": "Учебная коллекция для курса Java AQA.\n\n**Порядок запуска:** папка `01 Smoke` сверху вниз (Collection Runner).\n\n**Environment:** импортируй `Task-Manager-Sandbox.postman_environment.json` и выбери его в правом верхнем углу.\n\n**Demo user:** qa@demo.com / Demo123!",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Smoke",
      "description": "Основной сценарий: login → JWT → CRUD задачи → logout",
      "item": [
        {
          "name": "01 Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is JSON', function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('accessToken is present', function () {",
                  "    pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "pm.test('refreshToken is present', function () {",
                  "    pm.expect(body.refreshToken).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "pm.test('User email matches login', function () {",
                  "    pm.expect(body.user.email).to.eql(pm.environment.get('userEmail'));",
                  "});",
                  "",
                  "pm.test('User has globalRole USER', function () {",
                  "    pm.expect(body.user.globalRole).to.eql('USER');",
                  "});",
                  "",
                  "pm.environment.set('accessToken', body.accessToken);",
                  "pm.environment.set('refreshToken', body.refreshToken);",
                  "pm.environment.set('userId', body.user.id);",
                  "",
                  "pm.collectionVariables.set('accessToken', body.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login",
            "description": "Получаем accessToken и refreshToken. Токены сохраняются в environment."
          }
        },
        {
          "name": "02 Get Me",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Email matches environment', function () {",
                  "    pm.expect(body.email).to.eql(pm.environment.get('userEmail'));",
                  "});",
                  "",
                  "pm.test('User id matches login response', function () {",
                  "    pm.expect(body.id).to.eql(pm.environment.get('userId'));",
                  "});",
                  "",
                  "pm.test('Response time under 2000ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/me",
            "description": "Проверяем, что Bearer token работает."
          }
        },
        {
          "name": "03 Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('New accessToken issued', function () {",
                  "    pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "pm.test('New refreshToken issued', function () {",
                  "    pm.expect(body.refreshToken).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "pm.environment.set('accessToken', body.accessToken);",
                  "pm.environment.set('refreshToken', body.refreshToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/refresh",
            "description": "Обновляем пару токенов по refreshToken."
          }
        },
        {
          "name": "04 List Projects — find DEMO",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Projects list is not empty', function () {",
                  "    pm.expect(body.content).to.be.an('array').that.is.not.empty;",
                  "});",
                  "",
                  "const demo = body.content.find(p => p.key === 'DEMO');",
                  "",
                  "pm.test('Project DEMO exists in seed data', function () {",
                  "    pm.expect(demo, 'Project with key DEMO not found').to.exist;",
                  "});",
                  "",
                  "if (demo) {",
                  "    pm.environment.set('demoProjectId', demo.id);",
                  "    pm.test('DEMO project is not archived', function () {",
                  "        pm.expect(demo.archived).to.eql(false);",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/projects?size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "projects"],
              "query": [{ "key": "size", "value": "20" }]
            }
          }
        },
        {
          "name": "05 List Tasks — project DEMO",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Has pagination meta', function () {",
                  "    pm.expect(body.meta).to.have.property('totalElements');",
                  "});",
                  "",
                  "pm.test('Seed tasks exist', function () {",
                  "    pm.expect(body.content.length).to.be.at.least(1);",
                  "});",
                  "",
                  "pm.test('All tasks belong to DEMO project', function () {",
                  "    const projectId = pm.environment.get('demoProjectId');",
                  "    body.content.forEach(task => {",
                  "        pm.expect(task.projectId).to.eql(projectId);",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks?projectId={{demoProjectId}}&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks"],
              "query": [
                { "key": "projectId", "value": "{{demoProjectId}}" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "06 Create Task",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.environment.set('taskTitle', 'Postman-smoke-' + Date.now());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Task title matches request', function () {",
                  "    pm.expect(body.title).to.eql(pm.environment.get('taskTitle'));",
                  "});",
                  "",
                  "pm.test('Default status is TODO', function () {",
                  "    pm.expect(body.status).to.eql('TODO');",
                  "});",
                  "",
                  "pm.test('Priority is HIGH', function () {",
                  "    pm.expect(body.priority).to.eql('HIGH');",
                  "});",
                  "",
                  "pm.test('Project id matches DEMO', function () {",
                  "    pm.expect(body.projectId).to.eql(pm.environment.get('demoProjectId'));",
                  "});",
                  "",
                  "pm.environment.set('taskId', body.id);",
                  "pm.environment.set('taskVersion', body.version);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectId\": \"{{demoProjectId}}\",\n  \"title\": \"{{taskTitle}}\",\n  \"description\": \"Created by Postman smoke test\",\n  \"priority\": \"HIGH\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/tasks"
          }
        },
        {
          "name": "07 Get Task by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Response has task wrapper', function () {",
                  "    pm.expect(body.task).to.be.an('object');",
                  "});",
                  "",
                  "pm.test('Task id matches created task', function () {",
                  "    pm.expect(body.task.id).to.eql(pm.environment.get('taskId'));",
                  "});",
                  "",
                  "pm.test('Task title matches', function () {",
                  "    pm.expect(body.task.title).to.eql(pm.environment.get('taskTitle'));",
                  "});",
                  "",
                  "pm.environment.set('taskVersion', body.task.version);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/tasks/{{taskId}}"
          }
        },
        {
          "name": "08 Update Task Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "const oldVersion = Number(pm.environment.get('taskVersion'));",
                  "",
                  "pm.test('Status changed to IN_PROGRESS', function () {",
                  "    pm.expect(body.status).to.eql('IN_PROGRESS');",
                  "});",
                  "",
                  "pm.test('Version incremented (optimistic lock)', function () {",
                  "    pm.expect(body.version, 'version must grow after update').to.be.above(oldVersion);",
                  "});",
                  "",
                  "pm.test('updatedAt changed after status update', function () {",
                  "    pm.expect(body.updatedAt).to.not.eql(body.createdAt);",
                  "});",
                  "",
                  "pm.environment.set('taskVersion', body.version);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\",\n  \"version\": {{taskVersion}}\n}"
            },
            "url": "{{baseUrl}}/api/v1/tasks/{{taskId}}/status"
          }
        },
        {
          "name": "09 Delete Task",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 204 No Content', function () {",
                  "    pm.response.to.have.status(204);",
                  "});",
                  "",
                  "pm.test('Response body is empty', function () {",
                  "    pm.expect(pm.response.text()).to.be.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/v1/tasks/{{taskId}}"
          }
        },
        {
          "name": "10 Get Deleted Task — expect 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 404 Not Found', function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Error code is NOT_FOUND', function () {",
                  "    pm.expect(body.code).to.eql('NOT_FOUND');",
                  "});",
                  "",
                  "pm.test('Error has path field', function () {",
                  "    pm.expect(body.path).to.include('/api/v1/tasks/');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/tasks/{{taskId}}"
          }
        },
        {
          "name": "11 Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 204 No Content', function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/logout",
            "description": "Отзываем refresh token. После logout access token ещё валиден до истечения TTL."
          }
        }
      ]
    },
    {
      "name": "02 Negative",
      "description": "Негативные проверки. Запрос «Create Task — empty title» требует setup (login + DEMO project) — они идут перед ним в этой папке.",
      "item": [
        {
          "name": "Login — wrong password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401 Unauthorized', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Error code is UNAUTHORIZED', function () {",
                  "    pm.expect(body.code).to.eql('UNAUTHORIZED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"WrongPassword123!\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Get Me — without token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401 Unauthorized', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('Error code is UNAUTHORIZED', function () {",
                  "    pm.expect(pm.response.json().code).to.eql('UNAUTHORIZED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/me"
          }
        },
        {
          "name": "Setup — Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Setup login: status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.environment.set('accessToken', body.accessToken);",
                  "pm.environment.set('refreshToken', body.refreshToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login",
            "description": "Подготовка для негативного теста создания задачи."
          }
        },
        {
          "name": "Setup — Find DEMO project",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Setup projects: status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const demo = pm.response.json().content.find(p => p.key === 'DEMO');",
                  "pm.test('Project DEMO exists', function () {",
                  "    pm.expect(demo).to.exist;",
                  "});",
                  "if (demo) {",
                  "    pm.environment.set('demoProjectId', demo.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/projects?size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "projects"],
              "query": [{ "key": "size", "value": "20" }]
            }
          }
        },
        {
          "name": "Create Task — empty title",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Error code is VALIDATION_ERROR', function () {",
                  "    pm.expect(body.code).to.eql('VALIDATION_ERROR');",
                  "});",
                  "",
                  "pm.test('Details mention title field', function () {",
                  "    const fields = body.details.map(d => d.field);",
                  "    pm.expect(fields).to.include('title');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectId\": \"{{demoProjectId}}\",\n  \"title\": \"\",\n  \"priority\": \"HIGH\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/tasks"
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "accessToken", "value": "" }
  ]
}
