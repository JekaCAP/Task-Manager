  "item": [
    {
      "name": "Happy path",
      "item": [
        {
          "name": "00 Get access token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\npm.test(\"Body should contain access token\", function () {\r\n    pm.response.to.have.jsonBody(\"accessToken\");\r\n});\r\npm.test(\"AccessToken is not empty\", function () {\r\n    pm.expect(pm.response.json().accessToken).to.not.be.empty;\r\n});\r\nconst body = pm.response.json();\r\npm.collectionVariables.set(\"accessToken\", body.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "*/*"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "01 Get projects",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\nvar demo = pm.response.json().content.find(p => p.key === \"DEMO\");\r\npm.test(\"Contains Project with key 'DEMO'\", function () {\r\n    pm.expect(demo).to.exist;\r\n});\r\npm.environment.set(\"demoProjectId\", demo.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/projects?size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "projects"
              ],
              "query": [
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "02 Create Task",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const initials = 'DA'; // замените на свои инициалы\r\nconst uniqueTitle = `HW-${initials}-${Date.now()}`;\r\npm.environment.set('taskTitle', uniqueTitle);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {\n    pm.response.to.have.status(201);\n});\nconst responseJson = pm.response.json();\n\npm.test(\"Task status equal TODO\", function () {\n    pm.expect(responseJson.status).to.eql(\"TODO\");\n});\n\npm.test(\"Task title is correct\", function () {\n    pm.expect(responseJson.title).to.eql(pm.environment.get(\"taskTitle\"));\n});\n\npm.test(\"Version is equal 0\", function() {\n    pm.expect(responseJson.version).to.eql(0);\n});\n\npm.environment.set(\"taskId\", responseJson.id);\npm.environment.set(\"taskVersion\", responseJson.version);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"projectId\": \"{{demoProjectId}}\",\r\n  \"title\": \"{{taskTitle}}\",\r\n  \"description\": \"Автотест\",\r\n  \"priority\": \"MEDIUM\"\r\n}\r\n",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tasks"
              ]
            }
          },
          "response": []
        },
        {
          "name": "03 Get Task by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\npm.test(\"Task id matches the environment variable\", function () {\r\n    var jsonData = pm.response.json();\r\n    pm.expect(jsonData.task.id).to.eql(pm.environment.get(\"taskId\"));\r\n});\r\n\r\npm.environment.set('taskVersion', String(pm.response.json().task.version));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks/{{taskId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tasks",
                "{{taskId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "04 Update Task status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {\r\n    pm.response.to.have.status(200);\r\n});\r\nconst body = pm.response.json();\r\nconst oldVersion = Number(pm.environment.get('taskVersion'));\r\npm.test('Status changed to IN_PROGRESS', function () {\r\n    pm.expect(body.status).to.eql('IN_PROGRESS');\r\n});\r\npm.test('Version incremented (optimistic lock)', function () {\r\n    pm.expect(body.version).to.be.above(oldVersion);\r\n});\r\npm.test('updatedAt changed', function () {\r\n    pm.expect(body.updatedAt).to.not.eql(body.createdAt);\r\n});\r\npm.environment.set('taskVersion', String(body.version));\r\n"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"status\": \"IN_PROGRESS\",\r\n  \"version\": {{taskVersion}}\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks/{{taskId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tasks",
                "{{taskId}}",
                "status"
              ]
            }
          },
          "response": []
        },
