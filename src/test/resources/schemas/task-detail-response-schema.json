{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "$ref": "#/components/schemas/TaskDetailResponse",
  "components": {
    "schemas": {
      "TaskDetailResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task", "tags", "commentsCount", "attachmentsCount"],
        "properties": {
          "task": { "$ref": "#/components/schemas/TaskResponse" },
          "tags": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/TagResponse" }
          },
          "commentsCount": { "type": "integer" },
          "attachmentsCount": { "type": "integer" }
        }
      },
      "TaskResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "projectId", "title", "status", "priority", "version", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "projectId": { "type": "string", "format": "uuid" },
          "title": { "type": "string" },
          "description": { "type": ["string", "null"] },
          "status": {
            "type": "string",
            "enum": ["TODO", "IN_PROGRESS", "REVIEW", "DONE", "CANCELLED"]
          },
          "priority": {
            "type": "string",
            "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
          },
          "assigneeId": { "type": ["string", "null"], "format": "uuid" },
          "dueDate": { "type": ["string", "null"], "format": "date-time" },
          "version": { "type": "integer" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "TagResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "projectId", "name", "createdAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "projectId": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "color": { "type": ["string", "null"] },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}