          "name": "02 Create Task",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const initials = 'DEY';\r\nconst uniqueTitle = `HW-${initials}-${Date.now()}`;\r\npm.environment.set('taskTitle', uniqueTitle);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201 Created', function () {\r\n    pm.response.to.have.status(201);\r\n});\r\nconst response = pm.response.json();\r\nconst uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\r\npm.test('TaskResponse has all required fields', function () {\r\n    pm.expect(response).to.include.keys(\r\n        'id', 'projectId', 'title', 'description', 'status', 'priority',\r\n        'assigneeId', 'dueDate', 'version', 'createdAt', 'updatedAt'\r\n    );\r\n});\r\npm.test('Default status is TODO, version is 0', function () {\r\n    pm.expect(response.status).to.eql('TODO');\r\n    pm.expect(response.version).to.eql(0);\r\n});\r\npm.test('Returned data matches sent data', function () {\r\n    pm.expect(response.title).to.eql(pm.variables.get('taskTitle'));\r\n    pm.expect(response.projectId).to.eql(pm.environment.get('demoProjectId'));\r\n    pm.expect(response.priority).to.eql('MEDIUM');\r\n});\r\npm.environment.set('taskId', response.id);\r\npm.environment.set('taskVersion', String(response.version));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"projectId\": \"{{demoProjectId}}\",\r\n  \"title\": \"{{taskTitle}}\",\r\n  \"description\": \"Автотест\",\r\n  \"priority\": \"MEDIUM\"\r\n}",
              "options": {
