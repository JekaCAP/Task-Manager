  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// Если токена нет — логинимся автоматически перед каждым запросом\r",
          "const token = pm.collectionVariables.get('accessToken');\r",
          "if (!token) {\r",
          "    const baseUrl = pm.environment.get('baseUrl');\r",
          "    const loginRes = await pm.sendRequest({\r",
          "        url: `${baseUrl}/api/v1/auth/login`,\r",
          "        method: 'POST',\r",
          "        header: { 'Content-Type': 'application/json' },\r",
          "        body: {\r",
          "            mode: 'raw',\r",
          "            raw: JSON.stringify({\r",
          "                email: pm.environment.get('userEmail'),\r",
          "                password: pm.environment.get('userPassword')\r",
          "            })\r",
          "        }\r",
          "    });\r",
          "    if (loginRes.code !== 200) {\r",
          "        console.error('Auto-login failed:', loginRes.code, loginRes.text());\r",
          "    } else {\r",
          "        const body = loginRes.json();\r",
          "        pm.collectionVariables.set('accessToken', body.accessToken);\r",
          "        pm.environment.set('userId', body.user.id);\r",
          "        console.log('Auto-login OK, userId =', body.user.id);\r",
          "    }\r",
          "}"
        ],
        "type": "text/javascript"
      }
    }
  ],
