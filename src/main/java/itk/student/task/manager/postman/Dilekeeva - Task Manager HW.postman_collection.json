              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {\r\n    pm.response.to.have.status(200);\r\n});\r\nconst body = pm.response.json();\r\npm.test('Projects list is not empty', function () {\r\n    pm.expect(body.content).to.be.an('array').that.is.not.empty;\r\n});\r\nconst demo = body.content.find(p => p.key === 'DEMO');\r\npm.test('Project DEMO exists in sandbox', function () {\r\n    pm.expect(demo, 'Project with key DEMO not found').to.exist;\r\n});\r\nif (demo) {\r\n    pm.environment.set('demoProjectId', demo.id);\r\n}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
