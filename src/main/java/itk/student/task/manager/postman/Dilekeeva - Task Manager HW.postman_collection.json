        {
          "name": "POST /api/v1/auth/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Сохраняем accessToken из ответа в переменную коллекции\r\nconst jsonData = pm.response.json();\r\npm.collectionVariables.set('accessToken', jsonData.accessToken);\r\n\r\npm.test(\"Статус-код 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Ответ содержит accessToken\", function () {\r\n    const jsonData = pm.response.json();\r\n    pm.expect(jsonData).to.have.property('accessToken');\r\n});\r\n\r\npm.test(\"accessToken не пустой\", function () {\r\n    const jsonData = pm.response.json();\r\n    pm.expect(jsonData.accessToken).to.not.be.empty;\r\n});\r\n\r\npm.test(\"Email пользователя совпадает с qa@demo.com\", function () {\r\n    const jsonData = pm.response.json();\r\n    pm.expect(jsonData.user.email).to.equal('qa@demo.com');\r\n});"
                ]
